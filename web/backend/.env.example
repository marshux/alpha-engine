# Copy to .env (gitignored) and fill in. Never commit real values.

# GitHub OAuth App credentials (github.com/settings/developers) -- the
# callback URL registered there must match /auth/callback on whatever host
# this is running on (e.g. http://localhost:8000/auth/callback for local
# dev, https://<app>.fly.dev/auth/callback in production).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only this GitHub username is allowed to log in -- this is a personal
# dashboard, not a multi-user product.
ALLOWED_GITHUB_USERNAME=

# Random long string used to sign the session cookie. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Optional -- defaults to <repo_root>/data/web.db if unset. In production
# this should point at a path on the persistent Fly.io volume.
DATABASE_PATH=

# Copy to .env (gitignored) and fill in. Never commit real keys.

# Used by src/alpha_engine/signals/news_ai.py for the AI news-research signal.
ANTHROPIC_API_KEY=

# Optional. Enables X/Twitter search (via X's own MCP server, api.x.com/mcp)
# alongside web_search in the news_ai signal. Requires an X developer app
# enrolled in X's pay-per-use billing -- a real, separate cost from the
# Anthropic bill. Leave unset to stay on web_search only (the default, no
# extra cost). This is a plain OAuth bearer token, not auto-refreshed by
# Anthropic (that's a Managed Agents-only vault feature) -- whoever owns
# the X developer app needs to rotate it manually before it expires.
X_MCP_AUTHORIZATION_TOKEN=

# Used by src/alpha_engine/broker/alpaca.py -- ALWAYS paper-trading keys
# (from https://app.alpaca.markets, paper account) since broker/alpaca.py
# hardcodes paper=True. Required for `alpha-engine live-rebalance`.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
